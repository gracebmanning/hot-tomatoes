{%- liquid
  assign product_collection = blank

  # Prefer the collection the user navigated from, unless it's a catch-all
  if collection != blank
    unless collection.handle == 'all' or collection.handle == 'frontpage' or collection.handle == 'shop'
      assign product_collection = collection
    endunless
  endif

  # Otherwise, fall back to the first specific collection the product belongs to
  if product_collection == blank
    for c in product.collections
      unless c.handle == 'all' or c.handle == 'frontpage' or c.handle == 'shop'
        assign product_collection = c
        break
      endunless
    endfor
  endif
-%}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list">
    <li class="breadcrumbs__item">
      <a href="{{ collections['shop'].url | default: routes.all_products_collection_url }}">Shop All</a>
    </li>
    {%- if product_collection != blank -%}
      <li class="breadcrumbs__item">
        <a href="{{ product_collection.url }}">{{ product_collection.title | escape }}</a>
      </li>
    {%- endif -%}
    <li class="breadcrumbs__item breadcrumbs__item--current">
      <span aria-current="page">{{ product.title | escape }}</span>
    </li>
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: 2rem;
  }

  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-weight: 500;
  }

  .breadcrumbs__item {
    display: flex;
    align-items: center;
  }

  .breadcrumbs__item:not(:last-child)::after {
    content: '›';
    margin: 0 0.5rem;
    opacity: 0.6;
  }

  .breadcrumbs__item a {
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }

  .breadcrumbs__item a:hover {
    text-decoration: underline;
  }

  .breadcrumbs__item--current span {
    opacity: 0.6;
  }
</style>
