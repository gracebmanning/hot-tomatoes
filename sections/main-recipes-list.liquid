<div class="recipes-list">
  <h1>{{ blog.title }}</h1>
  <p class="recipes-list__intro">A growing collection of recipes that put Hot Tomatoes to work.</p>

  <div class="recipes-list__grid">
    {% for article in blog.articles %}
      <a href="{{ article.url }}" class="recipe-card">
        {% if article.image %}
          <div class="recipe-card__image">
            <img
              src="{{ article.image | image_url: width: 600 }}"
              alt="{{ article.image.alt | escape }}"
              loading="lazy"
              width="{{ article.image.width }}"
              height="{{ article.image.height }}"
            >
          </div>
        {% endif %}
        <div class="recipe-card__content">
          <h2 class="recipe-card__title">{{ article.title }}</h2>
          {% if article.metafields.custom.cook_time %}
            <p class="recipe-card__meta">
              {{ article.metafields.custom.cook_time }}
              {% if article.metafields.custom.serves %}
                · Serves {{ article.metafields.custom.serves }}
              {% endif %}
            </p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>

  {% if paginate.pages > 1 %}
    {% render 'pagination', paginate: paginate %}
  {% endif %}
</div>

<style>
  .recipes-list {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
    color: #494850;
  }

  .recipes-list h1 {
    font-family: var(--font-heading-family);
    font-size: 4rem;
    margin: 0 0 0 0;
    width: 100%;
    text-align: center;
  }

  .recipes-list__intro {
    margin-top: 0;
    margin-bottom: 3rem;
    width: 100%;
    text-align: center;
  }

  .recipes-list__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }

  .recipe-card {
    display: block;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    transition: transform 0.2s ease;
  }

  .recipe-card:hover {
    transform: translateY(-4px);
  }

  .recipe-card__image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .recipe-card__title {
    font-family: var(--font-heading-family);
    font-size: 2.5rem;
    margin: 1rem 0 0 0;
  }

  .recipe-card__meta {
    font-size: 1.5rem;
    margin: 0 0 0.5rem 0;
  }
</style>

{% schema %}
{
  "name": "Recipes List",
  "tag": "section",
  "settings": []
}
{% endschema %}
