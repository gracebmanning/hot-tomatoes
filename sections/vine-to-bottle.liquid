<script src="{{ 'vine-section.js' | asset_url }}" defer="defer"></script>
<style>
    .vine-section {
        position: relative;
        background-color: #F7F4F1;
    }

    .vine-section__stage {
        position: relative;
        height: 130vh;
    }

    .vine-section__stage--fall {
        height: 200vh;
    }

    .vine-section__sticky-frame {
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 0 2rem;
    }

    .vine-section__heading {
        font-family: var(--font-heading-family);
        font-size: clamp(4rem, 10vw, 12rem);
        color: #BF0603;
        margin: 0;
        text-align: center;
    }

    .vine-section__stage--fall .vine-section__artwork {
        width: 280px;
        margin-bottom: 2rem;
    }

    .vine-section__stage--fall .vine-section__artwork svg {
        width: 100%;
        height: auto;
        display: block;
        overflow: visible;
    }

    .vine-section__stage--fall .vine-section__sticky-frame {
        overflow: visible;
    }

    #detachable-tomato {
        transform-origin: center;
        transform-box: fill-box;
        will-change: transform;
    }

    .vine-section__stage--bottle {
        height: 260vh;
    }

    .vine-section__bottle {
        position: relative;
        width: 175px;
        height: auto;
        display: block;
        z-index: 2;
    }

    .vine-section__bottle svg {
        width: 100%;
        height: auto;
        display: block;
    }

    .vine-section__thermometer {
        position: absolute;
        width: 70px;
        height: auto;
        bottom: 20%;
        display: block;
        z-index: 2;
    }

    .vine-section__thermometer svg {
        width: 100%;
        height: auto;
        display: block;
    }

    .thermometer-fill {
        transform-origin: center bottom;
        transform-box: fill-box;
        will-change: transform;
    }

    .vine-section__heading--punch {
        position: absolute;
        bottom: 0%;
        left: 50%;
        transform: translateX(-50%);
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: 2;
        width: 100%;
    }

    .vine-section__bottle .bottle-shape {
        transition: fill 0.1s linear;
        will-change: fill;
    }

    .vine-section__hot-sticker {
        position: absolute;
        top: 30%;
        right: 32%;
        width: 100px;
        height: 100px;
        opacity: 0;
        transition: opacity 0.6s ease, transform 0.4s ease;
        pointer-events: auto;
        transform-origin: center;
        z-index: 1;
    }

    .vine-section__hot-sticker:hover {
        transform: rotate(15deg) scale(1.2);
    }

    .vine-section__hot-sticker svg {
        width: 100%;
        height: auto;
        display: block;
    }

    @media (prefers-reduced-motion: reduce) {
        #detachable-tomato {
            transform: translateY(50%);
        }

        .vine-section__hot-sticker {
            opacity: 1;
            transition: none;
        }

        .vine-section__hot-sticker:hover {
            transform: none;
        }

        .bottle-shape {
            fill: #7A1414;
        }

        .thermometer-fill {
            transform: scaleY(1);
        }

        .vine-section__heading--punch {
            opacity: 1;
        }
    }
</style>

